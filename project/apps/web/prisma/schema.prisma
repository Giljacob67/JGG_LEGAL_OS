model AuditLog {
  id         BigInt   @id @default(autoincrement())
  userId     String?
  userEmail  String?
  acao       String
  entidade   String
  entidadeId String
  diff       Json?
  ip         String?
  userAgent  String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entidade, entidadeId])
  @@index([createdAt])
}

// ============================================================
// LGPD (Lei Geral de Proteção de Dados) - Módulo Básico
// ============================================================

enum ConsentPurpose {
  client_onboarding
  process_management
  financial
  marketing
  third_party
  legal_obligation
  other
}

enum DataSubjectRight {
  access
  rectification
  erasure
  portability
  restriction_processing
  objection
}

enum LGPDRequestStatus {
  received
  validating
  in_progress
  completed
  rejected
  cancelled
}

model Consent {
  id            String          @id @default(cuid())
  clienteId     String
  cliente       Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  purpose       ConsentPurpose
  granted       Boolean
  grantedAt     DateTime?
  revokedAt     DateTime?
  legalBasis    String?         // Ex: "Art. 7º, I - consentimento do titular"
  consentText   String?         @db.Text // Versão do texto de consentimento apresentado
  version       String?         // Versão do termo
  ipAddress     String?
  userAgent     String?
  collectedById String?
  collectedBy   User?           @relation(fields: [collectedById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([clienteId])
  @@index([purpose])
}

model LGPDRequest {
  id            String              @id @default(cuid())
  clienteId     String?
  cliente       Cliente?            @relation(fields: [clienteId], references: [id])
  requestType   DataSubjectRight
  status        LGPDRequestStatus   @default(received)
  description   String?             @db.Text
  requestedBy   String?             // Nome/email de quem solicitou (pode ser o próprio titular ou representante)
  requestedAt   DateTime            @default(now())
  dueDate       DateTime?           // Prazo legal (geralmente 15 dias)
  processedById String?
  processedBy   User?               @relation(fields: [processedById], references: [id])
  completedAt   DateTime?
  response      String?             @db.Text
  attachments   Json?               // Referências a documentos enviados
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([clienteId])
  @@index([status])
  @@index([requestType])
}

