# JGG Process Monitor — Configuração de exemplo

# App
SERVICE_NAME=process-monitor
DEBUG=false
PORT=8001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/process_monitor

# Redis
REDIS_URL=redis://localhost:6379/1

# DataJud (API Pública CNJ)
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# Rate limits (segundos entre requisições)
DEFAULT_RATE_LIMIT_SECONDS=5.0
TJPR_RATE_LIMIT_SECONDS=10.0
TJMT_RATE_LIMIT_SECONDS=10.0
TRF4_RATE_LIMIT_SECONDS=10.0
TRF1_RATE_LIMIT_SECONDS=10.0

# Circuit breaker
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300.0

# Conectores
# true = stubs retornam mocks
# false = stubs retornam NOT_IMPLEMENTED
MOCK_CONNECTORS=true

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
