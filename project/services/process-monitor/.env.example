# JGG Process Monitor — Configuração de exemplo

# ============================================================
# AVISO LEGAL E DE COMPLIANCE (IMPORTANTE)
# ============================================================
# Este serviço acessa sistemas de tribunais brasileiros.
# Antes de ativar conectores reais (MOCK_CONNECTORS=false):
#   1. Obtenha parecer jurídico formal.
#   2. Documente a base legal (LGPD + regulamentos do CNJ).
#   3. Ative LOG_JSON=true e armazene logs de acesso por pelo menos 5 anos.
#   4. Nunca habilite scraping real sem aprovação do sócio responsável.
#
# Recomenda-se manter MOCK_CONNECTORS=true em todos os ambientes
# até que o compliance esteja 100% validado.
# ============================================================

# App
SERVICE_NAME=process-monitor
DEBUG=false
PORT=8001

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/process_monitor

# Redis
REDIS_URL=redis://localhost:6379/1

# DataJud (API Pública CNJ)
DATAJUD_API_KEY=
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_DEFAULT_ALIASES=api_publica_tjpr,api_publica_tjmt,api_publica_trf4,api_publica_trf1
DATAJUD_TIMEOUT_SECONDS=20.0

# Rate limits (segundos entre requisições)
DEFAULT_RATE_LIMIT_SECONDS=5.0
TJPR_RATE_LIMIT_SECONDS=10.0
TJMT_RATE_LIMIT_SECONDS=10.0
TRF4_RATE_LIMIT_SECONDS=10.0
TRF1_RATE_LIMIT_SECONDS=10.0

# Circuit breaker
CIRCUIT_BREAKER_FAILURES=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300.0

# Conectores Piloto
# Habilita conectores reais (true) ou stubs (false)
# RECOMENDADO: Mantenha true até ter parecer jurídico
MOCK_CONNECTORS=true

# Logging (CRÍTICO PARA COMPLIANCE)
# Mantenha LOG_JSON=true em produção para auditoria de acessos a tribunais
LOG_LEVEL=INFO
LOG_JSON=true

# TJPR (PROJUDI)
TJPR_CONNECTOR_ENABLED=false
TJPR_CONNECTOR_MODE=fixtures
TJPR_PUBLIC_SEARCH_URL=
TJPR_PUBLIC_SEARCH_METHOD=GET
TJPR_PUBLIC_SEARCH_HEADERS=
TJPR_RATE_LIMIT_SECONDS=10.0
TJPR_TIMEOUT_SECONDS=20.0
TJPR_FIXTURES_DIR=tests/fixtures/tjpr

# TRF4 (e-Proc)
TRF4_CONNECTOR_ENABLED=false
TRF4_CONNECTOR_MODE=fixtures
TRF4_PUBLIC_SEARCH_URL=
TRF4_PUBLIC_SEARCH_METHOD=GET
TRF4_PUBLIC_SEARCH_HEADERS=
TRF4_RATE_LIMIT_SECONDS=10.0
TRF4_TIMEOUT_SECONDS=20.0
TRF4_FIXTURES_DIR=tests/fixtures/trf4

# TJMT (PJe)
TJMT_CONNECTOR_ENABLED=false
TJMT_CONNECTOR_MODE=fixtures
TJMT_PUBLIC_SEARCH_URL=
TJMT_PUBLIC_SEARCH_METHOD=GET
TJMT_PUBLIC_SEARCH_HEADERS=
TJMT_RATE_LIMIT_SECONDS=10.0
TJMT_TIMEOUT_SECONDS=20.0
TJMT_FIXTURES_DIR=tests/fixtures/tjmt

# TRF1 (PJe)
TRF1_CONNECTOR_ENABLED=false
TRF1_CONNECTOR_MODE=fixtures
TRF1_PUBLIC_SEARCH_URL=
TRF1_PUBLIC_SEARCH_METHOD=GET
TRF1_PUBLIC_SEARCH_HEADERS=
TRF1_RATE_LIMIT_SECONDS=10.0
TRF1_TIMEOUT_SECONDS=20.0
TRF1_FIXTURES_DIR=tests/fixtures/trf1

# TJSP (e-SAJ)
TJSP_CONNECTOR_ENABLED=false
TJSP_CONNECTOR_MODE=fixtures
TJSP_PUBLIC_SEARCH_URL=
TJSP_PUBLIC_SEARCH_METHOD=GET
TJSP_PUBLIC_SEARCH_HEADERS=
TJSP_RATE_LIMIT_SECONDS=10.0
TJSP_TIMEOUT_SECONDS=20.0
TJSP_FIXTURES_DIR=tests/fixtures/tjsp

# TJRS (e-SAJ)
TJRS_CONNECTOR_ENABLED=false
TJRS_CONNECTOR_MODE=fixtures
TJRS_PUBLIC_SEARCH_URL=
TJRS_PUBLIC_SEARCH_METHOD=GET
TJRS_PUBLIC_SEARCH_HEADERS=
TJRS_RATE_LIMIT_SECONDS=10.0
TJRS_TIMEOUT_SECONDS=20.0
TJRS_FIXTURES_DIR=tests/fixtures/tjrs

# Webhooks (Next.js app web)
WEBHOOK_NEW_MOVEMENTS_ENABLED=false
WEBHOOK_NEW_MOVEMENTS_URL=
WEBHOOK_NEW_MOVEMENTS_HEADERS=
WEBHOOK_NEW_MOVEMENTS_KEY=

# Fallback DataJud
ENABLE_DATAJUD_FALLBACK=true

# Scheduler (APScheduler)
SCHEDULER_SYNC_ENABLED=false
SCHEDULER_SYNC_INTERVAL_MINUTES=60
SCHEDULER_HEALTHCHECK_ENABLED=true
SCHEDULER_HEALTHCHECK_INTERVAL_MINUTES=30
