# =============================================================================
# JGG Monitoring Service — Variáveis de Ambiente
# =============================================================================

# PostgreSQL (mesmo banco do app Next.js, schema monitoring)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jgg_legal_os

# Redis (eventos / pub-sub)
REDIS_URL=redis://localhost:6379
REDIS_CHANNEL_EVENTOS=jgg:eventos

# MinIO / S3 (armazenamento de documentos)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTOS=documentos-tribunais
MINIO_SECURE=false

# Segurança
MONITORING_ENCRYPTION_KEY=base64_fernet_key_32_bytes==
MONITORING_API_KEY=change_me_in_production

# Servidor
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# Scheduler (minutos/horas)
SYNC_ATIVOS_INTERVALO_MIN=30
SYNC_ARQUIVADOS_HORA=2
HEALTH_CHECK_INTERVALO_MIN=15
RETRY_FALHAS_INTERVALO_H=1
MAX_TENTATIVAS_CAPTURA=3

# Webhook (opcional — notificações para o Next.js)
WEBHOOK_URL=http://localhost:3000/api/webhooks/monitoring
WEBHOOK_SECRET=webhook_secret_change_me

# Playwright (opcional — apenas se necessário para captchas)
# PLAYWRIGHT_HEADLESS=true
